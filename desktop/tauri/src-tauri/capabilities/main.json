{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities for the main window: sidecar management and remote viewer windows.",
  "windows": ["main", "remote-*"],
  "permissions": [
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "shell:allow-open",
    "core:window:default",
    "core:webview:default"
  ]
}
